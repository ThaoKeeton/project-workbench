{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workbench.test-executor.authored-script.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "name", "steps"],
  "properties": {
    "schema": { "const": "workbench.test-executor.authored-script.v1" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "note": { "type": "string", "maxLength": 500 },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "automationId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "selector": { "type": "string", "minLength": 1, "maxLength": 200 },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": { "type": "string", "minLength": 1, "maxLength": 200 },
        "object": { "type": "string", "minLength": 1, "maxLength": 80 },
        "uuid": { "type": "string", "minLength": 1, "maxLength": 80 },
        "path": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "anyOf": [
        { "required": ["name"] },
        { "required": ["automationId"] },
        { "required": ["selector"] },
        { "required": ["text"] },
        { "required": ["role"] },
        { "required": ["title"] },
        { "required": ["url"] },
        { "required": ["object"] },
        { "required": ["uuid"] },
        { "required": ["path"] }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["web", "scene3d"] },
        "action": { "enum": ["click", "type", "set-value", "invoke", "expand", "wait-for", "read", "assert-text", "assert-visible", "assert-network", "screenshot", "switch-window", "open-file", "read-scene", "project", "drag", "orbit", "assert-scene", "probe", "snapshot", "diff", "wheel", "compare-pixels"] },
        "target": { "$ref": "#/$defs/selector" },
        "expected": { "$ref": "#/$defs/note" },
        "input": { "$ref": "#/$defs/note" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "allowFallback": { "type": "boolean" },
        "sensitive": { "type": "boolean" },
        "allowPopup": { "type": "boolean" },
        "tolerance": { "type": "number", "minimum": 0, "maximum": 1000 }
      }
    }
  }
}
