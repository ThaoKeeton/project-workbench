<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Workbench.Shell.Web</RootNamespace>
    <AssemblyName>Workbench.Shell.Web</AssemblyName>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <InformationalVersion>0.5.0-preview.1</InformationalVersion>
    <Description>Thin WinUI 3 WebView2 shell for the v2 preview. The existing Workbench.App host is unchanged.</Description>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="../Workbench.Service/Workbench.Service.csproj" />
  </ItemGroup>
  <Target Name="StagePreviewPlugin" AfterTargets="Build">
    <PropertyGroup>
      <_SampleOut>$(MSBuildThisFileDirectory)../../plugins/v2/Workbench.TestCases.V2/bin/$(Configuration)/net10.0/</_SampleOut>
      <_Stage>$(OutputPath)preview-plugins/com.projectworkbench.test-cases.v2/</_Stage>
    </PropertyGroup>
    <MakeDir Directories="$(_Stage)" />
    <Copy SourceFiles="$(_SampleOut)Workbench.TestCases.V2.dll;$(_SampleOut)Workbench.TestCases.V2.deps.json;$(MSBuildThisFileDirectory)../../plugins/v2/Workbench.TestCases.V2/plugin.v2.json" DestinationFolder="$(_Stage)" SkipUnchangedFiles="true" />
  </Target>
</Project>
