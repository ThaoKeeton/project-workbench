<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Workbench.App/HostRuntime.cs" Link="Host/HostRuntime.cs" />
    <Compile Include="../../src/Workbench.App/RunOptions.cs" Link="Host/RunOptions.cs" />
    <Compile Include="../../src/Workbench.App/HostFailure.cs" Link="Host/HostFailure.cs" />
    <Compile Include="../../src/Workbench.App/NativeProbeEvidence.cs" Link="Host/NativeProbeEvidence.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Workbench.Core/Workbench.Core.csproj" />
    <ProjectReference Include="../Workbench.TestDependency/Workbench.TestDependency.csproj" />
    <ProjectReference Include="../Workbench.TestPlugin/Workbench.TestPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Workbench.DeploymentProbe/Workbench.DeploymentProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyPluginFixture" AfterTargets="Build">
    <ItemGroup>
      <FixtureFiles Include="../Workbench.TestPlugin/bin/$(Configuration)/$(TargetFramework)/Workbench.TestPlugin.dll;../Workbench.TestPlugin/bin/$(Configuration)/$(TargetFramework)/Workbench.TestPlugin.deps.json;../Workbench.TestPlugin/bin/$(Configuration)/$(TargetFramework)/Workbench.TestDependency.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureFiles)" DestinationFolder="$(OutDir)fixtures" />
  </Target>
  <Target Name="PublishDeploymentProbe" AfterTargets="Build">
    <MSBuild Projects="../Workbench.DeploymentProbe/Workbench.DeploymentProbe.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(TargetDir)deployment-probe/" />
  </Target>
</Project>
