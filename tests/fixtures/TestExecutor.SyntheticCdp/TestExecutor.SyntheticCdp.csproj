<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>TestExecutor.SyntheticCdp</RootNamespace>
    <AssemblyName>TestExecutor.SyntheticCdp</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
    <Description>Synthetic Electron stand-in that speaks CDP on a loopback debugging port.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Workbench.TestExecutor/Workbench.TestExecutor.csproj" />
  </ItemGroup>
</Project>
