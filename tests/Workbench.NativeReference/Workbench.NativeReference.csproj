<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWinUI>false</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Workbench.App/*.cs" Link="App/%(Filename)%(Extension)" />
    <Compile Include="GeneratedApplicationReference.cs" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="../../src/Workbench.Core/Workbench.Core.csproj" />
    <ProjectReference Include="../../src/Workbench.WinUI.Sdk/Workbench.WinUI.Sdk.csproj" />
    <ProjectReference Include="../Workbench.NativeFixture/Workbench.NativeFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../plugins/Workbench.Testing/Workbench.Testing.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
