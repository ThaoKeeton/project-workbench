<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../../src/Workbench.TestExecutor/Workbench.TestExecutor.csproj" />
    <ProjectReference Include="../../src/Workbench.TestExecutor.Windows/Workbench.TestExecutor.Windows.csproj" />
    <ProjectReference Include="../fixtures/TestExecutor.SampleApp/TestExecutor.SampleApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageSampleApp" AfterTargets="Build">
    <PropertyGroup>
      <_SampleOut>$(MSBuildThisFileDirectory)../fixtures/TestExecutor.SampleApp/bin/$(Configuration)/net10.0-windows10.0.19041.0/</_SampleOut>
    </PropertyGroup>
    <ItemGroup>
      <_SampleFiles Include="$(_SampleOut)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SampleFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
